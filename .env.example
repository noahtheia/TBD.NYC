# Mapbox GL access token (public token, starts with "pk.").
# Get one free at https://account.mapbox.com/access-tokens/
# Used client-side by the map and by scripts/build-data.mjs for geocoding.
# Recommended: restrict the token to your domain(s) in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Public site URL (absolute origin, e.g. https://tbd.nyc). Used for canonical /
# Open Graph URLs, the sitemap, and robots.txt. REQUIRED in production — if unset,
# these fall back to http://localhost:3000 (on Vercel, VERCEL_PROJECT_PRODUCTION_URL
# is used before that), which would de-index the site.
NEXT_PUBLIC_SITE_URL=

# Google Maps Platform API key with "Places API (New)" enabled.
# Used by scripts/build-data.mjs (bulk enrichment) and the admin "Enrich from
# Google" action. Server/build-time only — never shipped to the browser.
GOOGLE_PLACES_API_KEY=

# --- Supabase (optional) ---------------------------------------------------
# When set, the site reads venues live from Supabase (ISR); otherwise it falls
# back to data/venues.json. URL + anon key are public (safe with RLS public-read).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SECRET. Used by `npm run seed` and the admin write actions.
# Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the in-app /admin (also signs the admin session cookie). SECRET.
ADMIN_PASSWORD=

# Postgres connection string for running migrations (npm run migrate). SECRET.
# Use the Supabase "Session pooler" string (IPv4) on networks without IPv6.
# Optional — schema can also be applied via the Supabase SQL editor.
SUPABASE_DB_URL=
